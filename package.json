{
  "name": "family-tree-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server untuk Family Roots, Money Track, dan Task Board",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
