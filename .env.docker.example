# Docker / server only (local dev pakai .env + npm run dev)
#   cp .env.docker.example .env.docker
#   bash scripts/deploy.sh   (atau npm run deploy)

# ── HTTP MCP server ───────────────────────────────────────────────
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3100

# ── FamilyRoots API ───────────────────────────────────────────────
# Wajib. Dari container, pakai nama service/container API — JANGAN 127.0.0.1.
# Samakan dengan network Docker API (lihat docker-compose.yml).
FAMILY_API_BASE_URL=http://family-suite-api:3000/api/v1
FAMILY_MCP_REQUEST_TIMEOUT_MS=15000

# ── Guardrail tool ────────────────────────────────────────────────
# Tool tulis Task Board (create/update/status/revision) hanya aktif kalau true.
FAMILY_MCP_ENABLE_WRITE=true
# Tool destruktif (delete task/workplace/transaction) hanya aktif kalau true.
FAMILY_MCP_ENABLE_DESTRUCTIVE=false

# ── Logging ───────────────────────────────────────────────────────
# debug | info | warn | error
FAMILY_MCP_LOG_LEVEL=info
